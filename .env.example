# Copy to .env.local and fill in. Never commit real values.

# --- Site ---------------------------------------------------------------------
# Public URL of the deployed site (used for metadata, OG images, sitemap and auth links).
# Falls back to https://usetrendcart.com when unset (see config/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database -----------------------------------------------------------------
# Neon Postgres connection string (pooled), used by the app, drizzle-kit and pnpm db:seed.
# Local development without Neon: pglite:./.data/dev (embedded Postgres persisted in .data/,
# migrations applied automatically; dev only, refused in production). pglite:memory = throwaway.
DATABASE_URL=

# --- Auth and encryption ------------------------------------------------------
# Better Auth signing secret, 32+ random chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Better Auth base URL when it differs from NEXT_PUBLIC_SITE_URL (e.g. preview deployments).
BETTER_AUTH_URL=
# AES-256-GCM keyring for tokens/secrets: one base64 32-byte key, or "2:<key>,1:<key>" (first = active) to rotate.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Email (live mode) ----------------------------------------------------------
# Resend API key for verification and invitation emails. Required when INTEGRATIONS_MODE=live
# (sending throws without it); in mock mode links are printed to the server console instead.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "Trendcart <no-reply@yourdomain.com>".
MAIL_FROM=

# --- Integrations -------------------------------------------------------------
# mock = local fakes, no external calls (default); live = real APIs.
# Must be "live" on Vercel production (VERCEL_ENV=production): the app refuses to start otherwise.
INTEGRATIONS_MODE=mock
# Optional override for the read-only analysis adapters: TikTok data (import, related videos),
# product analysis (GEMINI_API_KEY), supplier search (SERPAPI_KEY, FIRECRAWL_API_KEY) and page
# copywriting (ANTHROPIC_API_KEY). Shopify, TikTok Ads/posting, compliance and email keep
# following INTEGRATIONS_MODE. Unset = same as INTEGRATIONS_MODE; "mock" refused in production.
# Example: INTEGRATIONS_MODE=mock + AI_MODE=live tests real identification with no store writes.
AI_MODE=live

# Product pipeline engine: workflow = Vercel Workflow (durable), inline = runs steps in the request.
# Default: workflow when VERCEL=1, inline otherwise (local dev, PGlite, tests).
PIPELINE_ENGINE=

# Shopify app API key (client id) of the public app.
SHOPIFY_API_KEY=
# Shopify app API secret, also used to verify OAuth and webhook HMACs.
SHOPIFY_API_SECRET=
# Pinned Shopify Admin API version (optional, default 2026-10, the latest stable).
SHOPIFY_API_VERSION=
# 1 = also ask stores for write_themes at install, so Claude can write the CRO
# templates it designs (templates/product.tc-*.json). Needs the scope in the app
# config AND Shopify's theme-modification exemption for the app. Optional.
SHOPIFY_THEME_WRITES=

# Supplier APIs (optional). Without them, CJ and AliExpress are found through a
# Google search on the marketplace (prices often missing). Amazon always uses
# SerpApi's Amazon engine (SERPAPI_KEY). Prices are kept in USD or EUR only.
# CJ Dropshipping API key (CJ account > Authorization > API), format CJxxxx@api@xxxx.
CJ_API_KEY=
# AliExpress Open Platform, Affiliate API app (openservice.aliexpress.com).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Affiliate tracking id of that app (AliExpress Portals).
ALIEXPRESS_TRACKING_ID=

# TikTok Marketing API (Ads) app id.
TIKTOK_APP_ID=
# TikTok Marketing API (Ads) app secret.
TIKTOK_APP_SECRET=
# TikTok Login Kit / Content Posting API client key.
TIKTOK_LOGIN_CLIENT_KEY=
# TikTok Login Kit / Content Posting API client secret.
TIKTOK_LOGIN_CLIENT_SECRET=
# true = use the TikTok Ads sandbox environment.
TIKTOK_SANDBOX=true
# true only after TikTok approves the Content Posting API audit (allows non-private posts).
TIKTOK_POSTING_AUDITED=false

# Third-party TikTok data provider used to resolve and search public videos.
TIKTOK_DATA_PROVIDER=scrapecreators
# API key for that TikTok data provider.
TIKTOK_DATA_PROVIDER_KEY=

# --- AI providers (internal use) ----------------------------------------------
# Google Gemini (video analysis via the Files API).
GEMINI_API_KEY=
# Monthly AI spend cap per workspace in USD (default 50; 0 blocks all AI calls).
# Workspace owners can override it, the AI models and the AI time limits in /app/settings.
AI_MONTHLY_CAP_USD=50
# New product imports allowed per workspace per hour (re-imports are free; default 20).
IMPORT_RATE_LIMIT_PER_HOUR=20
# Optional model overrides (defaults live in lib/ai/pricing.ts); /app/settings wins over these.
AI_ANALYSIS_MODEL=
AI_COMPLIANCE_MODEL=
AI_COPYWRITING_MODEL=
# Anthropic Claude.
ANTHROPIC_API_KEY=
# Only for a key that is not scoped to an Anthropic Console workspace: the workspace id
# (Console > Settings > Workspaces), sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=
# OpenAI.
OPENAI_API_KEY=
# Perplexity (web research).
PERPLEXITY_API_KEY=

# --- Sourcing -----------------------------------------------------------------
# SerpApi key (reverse image and shopping search).
SERPAPI_KEY=
# Firecrawl key (listing page extraction).
FIRECRAWL_API_KEY=

# --- Infrastructure -----------------------------------------------------------
# Upstash Redis REST URL (rate limits incl. sign-in/sign-up/2FA, locks). Unset = per-process memory.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=
# Sentry DSN for error reporting (empty = disabled).
SENTRY_DSN=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
